# Copy this file to .env and adjust as needed. Nothing here is ever sent
# to the frontend -- the React app only ever calls this backend.

MAIN_MODEL_URL=http://127.0.0.1:8081
AGENT_MODEL_URL=http://127.0.0.1:8082
MAIN_MODEL_NAME=qwen2.5-1.5b-instruct
AGENT_MODEL_NAME=qwen2.5-0.5b-instruct

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional future integrations (never required):
# OPENAI_API_KEY=
# GEMINI_API_KEY=
